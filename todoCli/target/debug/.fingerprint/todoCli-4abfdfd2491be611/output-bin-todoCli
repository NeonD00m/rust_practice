o);\n}\n\nfn main() {\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"src/main.rs","byte_start":2463,"byte_end":2464,"line_start":90,"line_end":90,"column_start":27,"column_end":28,"is_primary":true,"text":[{"text":"        let t = tasks.get(i).unwrap(); // TODO: figure out how to get the tasks from this","highlight_start":27,"highlight_end":28}],"label":"slice indices are of type `usize` or ranges of `usize`","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"src/main.rs","byte_start":2459,"byte_end":2462,"line_start":90,"line_end":90,"column_start":23,"column_end":26,"is_primary":false,"text":[{"text":"        let t = tasks.get(i).unwrap(); // TODO: figure out how to get the tasks from this","highlight_start":23,"highlight_end":26}],"label":"required by a bound introduced by this call","suggested_replacement":null,"suggestion_applicability":null,"expansion":null}],"children":[{"message":"the trait `SliceIndex<[Task]>` is not implemented for `u8`","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"the trait `SliceIndex<[Task]>` is implemented for `usize`","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"for that trait implementation, expected `usize`, found `u8`","code":null,"level":"help","spans":[],"children":[],"rendered":null},{"message":"required by a bound in `core::slice::<impl [T]>::get`","code":null,"level":"note","spans":[{"file_name":"C:\\Users\\neonf\\.rustup\\toolchains\\stable-x86_64-pc-windows-msvc\\lib/rustlib/src/rust\\library\\core\\src\\slice\\mod.rs","byte_start":20186,"byte_end":20189,"line_start":6